# Canonical host used for metadata, canonicals and the sitemap.
NEXT_PUBLIC_SITE_URL=https://aimsuae.me

# Search indexing. Leave unset (or "false") on every preview; set to "true"
# only on the production deployment at launch.
SITE_INDEXABLE=false

# WhatsApp / phone / email links contact AIMS for real only when "true".
# Leave unset on previews: they show a notice instead (Plan risk R5).
NEXT_PUBLIC_LIVE_CONTACT=false
